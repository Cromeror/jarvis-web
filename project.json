{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web-app",
  "projectType": "application",
  "root": "packages/web-app",
  "sourceRoot": "packages/web-app/src",
  "targets": {
    "build": {
      "command": "vite build",
      "options": {
        "cwd": "packages/web-app"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "dev": {
      "command": "vite",
      "options": {
        "cwd": "packages/web-app"
      },
      "cache": false
    },
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "packages/web-app"
      },
      "cache": true
    }
  }
}
