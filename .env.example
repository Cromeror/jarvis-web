# Dónde vive la API de Jarvis. Vacío/ausente = el mismo origen que el front,
# o sea rutas relativas (sirve cuando un proxy publica ambos bajo un origen).
#
# OJO: es de BUILD-TIME. Vite la inlinea en el bundle, así que cambiarla exige
# `pnpm build` y volver a publicar — reiniciar no alcanza, no la lee ningún
# proceso. El prefijo VITE_ es obligatorio: es lo único que Vite expone al
# cliente.
# VITE_API_URL=https://api.jarvis.ejemplo

# Sólo para `pnpm dev`: a dónde manda el dev server las llamadas /api. Evita
# CORS en local sin declarar VITE_API_URL. No interviene en un build publicado.
JARVIS_API_PROXY=http://localhost:7433
